# ============================================================
# AX-OpsActivity-Automation — environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file (it is already git-ignored).
# ============================================================

# -------- Application under test --------
BASE_URL=https://beta-ax.siteplug.com
STATS_URL=https://beta-ax.siteplug.com/stats/base_stats_new.html
LOGIN_URL=https://beta-ax.siteplug.com/login

# -------- Microsoft login credentials (do NOT commit real values) --------
LOGIN_EMAIL=your.name@company.com
LOGIN_PASSWORD=replace-me

# Legacy aliases some scripts/CI jobs may still reference — keep in sync
# with LOGIN_EMAIL / LOGIN_PASSWORD above.
AX_USERNAME=soha.tembe@affinity.com
AX_PASSWORD=replace-me

# -------- Test data --------
DEFAULT_BRAND=Amazon
DEFAULT_COUNTRY=India
DEFAULT_DEVICE_CATEGORY=Mobile
DEFAULT_PLATFORM=Android
DEFAULT_ACCOUNT_MANAGER=Pooja Shah

# -------- Execution --------
# Set to a millisecond value (e.g. 1500) to add a visible pause between
# steps for headed demo runs. Leave unset/0 for normal + CI runs.
DEMO_DELAY=0

# -------- Email / executive report delivery --------
# SMTP transport used by utils/emailSender.ts. Works with Office365, Gmail
# (with an App Password), or any internal SMTP relay.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=reports@company.com
SMTP_PASSWORD=replace-me

REPORT_FROM_EMAIL=reports@company.com
REPORT_FROM_NAME=AX QA Automation
# Comma-separated list of recipients.
REPORT_TO_EMAIL=boss@company.com
REPORT_CC_EMAIL=
REPORT_SUBJECT_PREFIX=[AX Automation]

# Attach the full playwright-report (zipped) and allure-report to the email
# in addition to the inline executive dashboard. "true" / "false".
ATTACH_FULL_REPORT=true
